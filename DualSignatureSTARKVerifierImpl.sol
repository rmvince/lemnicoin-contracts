pragma solidity ^0.8.19;

import "./ISTARKVerifier.sol";
import "./interfaces/IFactRegistry.sol";

/**
 * @title DualSignatureSTARKVerifierImpl
 * @notice Production STARK verifier for dual-signature proofs
 * @dev Integrates with StarkWare's SHARP via Fact Registry pattern
 *
 * /// Lemnicoin is owner-sovereign.
 * /// Valid LAIP + Dilithium signatures define ownership.
 * /// Blockchains are execution venues only.
 *
 * ARCHITECTURE:
 * =============
 * This contract verifies STARK proofs generated by the Cairo program that verifies:
 * 1. 3072-bit LAIP Schnorr signature
 * 2. Dilithium5 (ML-DSA-87) post-quantum signature
 * 3. Cryptographic binding between both signatures
 *
 * VERIFICATION FLOW:
 * ==================
 * 1. User generates STARK proof off-chain using Stone prover
 * 2. Proof is submitted to SHARP (Shared Prover) for aggregation
 * 3. SHARP verifies aggregated proof and registers fact on-chain
 * 4. This contract queries the Fact Registry to check if fact exists
 *
 * SHARP Fact Registry (Mainnet): 0x47312450B3Ac8b5b8e247a6bB6d523e7605bDb60
 *
 * The proof commits to public inputs:
 * - messageHash: keccak256 of the signed message
 * - laipQHash: keccak256(Qx || Qy) of LAIP public key
 * - dilithiumPkHash: keccak256(dilithiumPk)
 * - sender: transaction sender address
 * - nonce: replay protection
 *
 * SECURITY MODEL:
 * ===============
 * - STARK proofs are computationally sound (128-bit security)
 * - No trusted setup required (transparent)
 * - Quantum-resistant (hash-based security)
 * - Public inputs verified against registered identity on-chain
 * - Battle-tested: In production since 2020 (StarkEx, dYdX, Immutable X)
 *
 * GAS COSTS:
 * ==========
 * - Full on-chain verification: ~160M gas (infeasible on mainnet)
 * - Fact registry lookup: ~5K gas (very cheap)
 * - Gas savings: ~99.99%
 */
contract DualSignatureSTARKVerifierImpl is ISTARKVerifier {
    // =========================================================================
    // STATE
    // =========================================================================

    /// @notice StarkWare SHARP Fact Registry contract
    /// @dev Mainnet: 0x47312450B3Ac8b5b8e247a6bB6d523e7605bDb60
    IFactRegistry public factRegistry;

    /// @notice Hash of the verified Cairo program
    bytes32 public override verifiedProgramHash;

    /// @notice Used proofs for replay protection
    mapping(bytes32 => bool) public override isProofUsed;

    /// @notice Contract owner
    address public owner;

    // SECURITY: Mock verification has been permanently removed.
    // All verification MUST go through the SHARP Fact Registry.
    // This ensures cryptographic soundness - forgery is computationally infeasible.

    // =========================================================================
    // EVENTS
    // =========================================================================

    event ProofVerified(
        address indexed sender,
        bytes32 indexed messageHash,
        bytes32 indexed fact,
        uint256 nonce,
        uint256 timestamp
    );

    event FactRegistryUpdated(address indexed oldRegistry, address indexed newRegistry);
    event ProgramHashUpdated(bytes32 indexed oldHash, bytes32 indexed newHash);

    // =========================================================================
    // ERRORS
    // =========================================================================

    error InvalidProof();
    error ProofAlreadyUsed();
    error InvalidPublicInputs();
    error InvalidProgramHash();
    error NotOwner();
    error FactNotRegistered();
    error FactRegistryNotSet();

    // =========================================================================
    // MODIFIERS
    // =========================================================================

    modifier onlyOwner() {
        if (msg.sender != owner) revert NotOwner();
        _;
    }

    // =========================================================================
    // CONSTRUCTOR
    // =========================================================================

    /**
     * @notice Deploy the STARK verifier
     * @param _factRegistry SHARP Fact Registry address (REQUIRED)
     *        Mainnet: 0x47312450B3Ac8b5b8e247a6bB6d523e7605bDb60
     *        Goerli:  0xAB43bA48c9edF4C2C4bB01237348D1D7B28ef168
     * @param _programHash Hash of the Cairo dual signature verification program (REQUIRED)
     *
     * SECURITY: A valid fact registry address is REQUIRED. This contract will NOT
     * function without a real SHARP Fact Registry. Mock verification has been
     * permanently removed to ensure cryptographic soundness.
     */
    constructor(address _factRegistry, bytes32 _programHash) {
        if (_factRegistry == address(0)) revert FactRegistryNotSet();
        if (_programHash == bytes32(0)) revert InvalidProgramHash();

        owner = msg.sender;
        factRegistry = IFactRegistry(_factRegistry);
        verifiedProgramHash = _programHash;
    }

    // =========================================================================
    // VERIFICATION FUNCTIONS
    // =========================================================================

    /**
     * @notice Verify a STARK proof with explicit public inputs
     * @dev This uses the SHARP Fact Registry pattern:
     *      1. Compute fact = keccak256(programHash || outputHash)
     *      2. Check if fact is registered in the Fact Registry
     *      3. If registered, SHARP has verified the proof
     *
     * @param inputs The public inputs the proof commits to
     * @param proof The proof containing outputHash from Cairo program
     * @return valid True if proof is valid for given inputs
     */
    function verifyProofWithInputs(
        PublicInputs calldata inputs,
        bytes calldata proof
    ) external override returns (bool valid) {
        // 1. Check proof not already used
        bytes32 proofHash = keccak256(proof);
        if (isProofUsed[proofHash]) revert ProofAlreadyUsed();

        // 2. Compute the expected output hash from public inputs
        bytes32 outputHash = _computeOutputHash(inputs);

        // 3. Compute the fact that should be registered
        bytes32 fact = keccak256(abi.encodePacked(verifiedProgramHash, outputHash));

        // 4. Verify fact is registered (either in registry or mock)
        bool factValid = _verifyFact(fact, proof);
        if (!factValid) revert FactNotRegistered();

        // 5. Mark proof as used
        isProofUsed[proofHash] = true;

        // 6. Emit event
        emit ProofVerified(
            inputs.sender,
            inputs.messageHash,
            fact,
            inputs.nonce,
            block.timestamp
        );

        return true;
    }

    /**
     * @notice Verify a raw STARK proof (inputs embedded in proof)
     * @param proof The complete STARK proof with embedded inputs
     *        Format: outputHash (32 bytes) || proofData
     * @return valid True if proof is valid
     */
    function verifyProof(bytes calldata proof) external override returns (bool valid) {
        if (proof.length < 32) revert InvalidProof();

        // Check proof not already used
        bytes32 proofHash = keccak256(proof);
        if (isProofUsed[proofHash]) revert ProofAlreadyUsed();

        // Extract output hash from proof
        bytes32 outputHash;
        assembly {
            outputHash := calldataload(proof.offset)
        }

        // Compute fact
        bytes32 fact = keccak256(abi.encodePacked(verifiedProgramHash, outputHash));

        // Verify fact is registered
        bool factValid = _verifyFact(fact, proof);
        if (!factValid) revert FactNotRegistered();

        // Mark proof as used
        isProofUsed[proofHash] = true;

        return true;
    }

    // =========================================================================
    // FACT REGISTRY INTEGRATION
    // =========================================================================

    /**
     * @notice Verify a fact is registered in the SHARP Fact Registry
     * @param fact The fact hash to verify
     * @return valid True if fact is registered
     *
     * SECURITY: This function ONLY queries the SHARP Fact Registry.
     * A fact is only valid if SHARP has cryptographically verified the underlying
     * STARK proof. This provides 128-bit computational security against forgery.
     */
    function _verifyFact(bytes32 fact, bytes calldata /* proof */) internal view returns (bool) {
        // SECURITY: All verification goes through SHARP Fact Registry.
        // No mock verification - forgery resistance is guaranteed.
        return factRegistry.isValid(fact);
    }

    /**
     * @notice Compute expected output hash from public inputs
     * @dev This must match what the Cairo program outputs
     */
    function _computeOutputHash(PublicInputs calldata inputs) internal pure returns (bytes32) {
        // Cairo program output format:
        // [messageHash, laipQHash, dilithiumPkHash, sender, nonce, result=1]
        return keccak256(abi.encodePacked(
            inputs.messageHash,
            inputs.laipQHash,
            inputs.dilithiumPkHash,
            uint256(uint160(inputs.sender)),
            inputs.nonce,
            uint256(1) // verification_result = success
        ));
    }

    /**
     * @notice Check if a specific fact is registered
     * @param outputHash The output hash from Cairo program execution
     * @return registered True if fact is in the registry
     */
    function isFactRegistered(bytes32 outputHash) external view returns (bool) {
        if (address(factRegistry) == address(0)) return false;
        bytes32 fact = keccak256(abi.encodePacked(verifiedProgramHash, outputHash));
        return factRegistry.isValid(fact);
    }

    /**
     * @notice Compute the fact hash for given inputs
     * @param inputs The public inputs
     * @return fact The fact hash
     */
    function computeFact(PublicInputs calldata inputs) external view returns (bytes32) {
        bytes32 outputHash = _computeOutputHash(inputs);
        return keccak256(abi.encodePacked(verifiedProgramHash, outputHash));
    }

    // =========================================================================
    // ADMIN FUNCTIONS
    // =========================================================================

    /**
     * @notice Update the Fact Registry address
     * @param _newRegistry New registry address (must be non-zero)
     *
     * SECURITY: The fact registry address is REQUIRED for verification.
     * Setting to address(0) will cause all verification to fail.
     */
    function setFactRegistry(address _newRegistry) external onlyOwner {
        if (_newRegistry == address(0)) revert FactRegistryNotSet();
        emit FactRegistryUpdated(address(factRegistry), _newRegistry);
        factRegistry = IFactRegistry(_newRegistry);
    }

    /**
     * @notice Update the verified program hash
     * @dev Used when deploying a new version of the Cairo program
     * @param _newHash New program hash
     */
    function setProgramHash(bytes32 _newHash) external onlyOwner {
        if (_newHash == bytes32(0)) revert InvalidProgramHash();
        emit ProgramHashUpdated(verifiedProgramHash, _newHash);
        verifiedProgramHash = _newHash;
    }

    /**
     * @notice Transfer ownership
     * @param _newOwner New owner address
     */
    function transferOwnership(address _newOwner) external onlyOwner {
        require(_newOwner != address(0), "Invalid new owner");
        owner = _newOwner;
    }

    // =========================================================================
    // VIEW FUNCTIONS
    // =========================================================================

    /**
     * @notice Get verification status for a proof
     * @param proof The proof to check
     * @return used True if proof was already verified
     */
    function getProofStatus(bytes calldata proof) external view returns (bool used) {
        return isProofUsed[keccak256(proof)];
    }

    /**
     * @notice Get the SHARP Fact Registry address
     * @return The fact registry address
     */
    function getFactRegistry() external view returns (address) {
        return address(factRegistry);
    }
}
