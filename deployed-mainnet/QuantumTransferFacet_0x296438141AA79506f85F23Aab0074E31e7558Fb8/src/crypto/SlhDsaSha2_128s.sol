pragma solidity ^0.8.25;

/// @title SlhDsaSha2_128s — on-chain SLH-DSA (SPHINCS+) verifier, FIPS 205, SHA2-128s parameter set
/// @notice Verifies a hash-based (LOS/SLH-DSA) signature over a 32-byte message digest (mu_v3),
///         using ONLY the SHA-256 precompile (address 0x02). This is the trust-minimizing factor:
///         it lets the chain confirm the user's post-quantum signature with no attestor in the loop.
///
///         Security foundation: SHA-256 preimage/collision hardness (Grover-only, exponential quantum
///         margin) — NIST FIPS 205, Category 1.
///
///         PARAMETERS (SLH-DSA-SHA2-128s): n=16, h=63, d=7, h'=9, a=12, k=14, w=16, len=35.
///         Public key = 32 bytes (PK.seed || PK.root). Signature = 7856 bytes.
///
///         VALIDATION STATUS: correctness is asserted by contracts/test/SlhDsaVerifier.test.js against
///         signatures generated by the noble post-quantum library (the same one vault/dApp/attestor use).
///         That vector test AND a gas measurement are the mandatory gate before the on-chain trustless
///         transfer path is enabled on mainnet (the LAIPV3TransferFacet keeps that path flag-gated off
///         until then). Verification is pure hashing; there is no secret input.
library SlhDsaSha2_128s {
    uint256 internal constant N = 16;
    uint256 internal constant H = 63;
    uint256 internal constant D = 7;
    uint256 internal constant HP = 9;      // h' = h/d
    uint256 internal constant A = 12;      // FORS tree height
    uint256 internal constant K = 14;      // FORS trees
    uint256 internal constant W = 16;
    uint256 internal constant LGW = 4;
    uint256 internal constant LEN1 = 32;
    uint256 internal constant LEN2 = 3;
    uint256 internal constant LEN = 35;    // len1 + len2
    uint256 internal constant M_DIGEST = 30; // Hmsg output bytes

    // ADRS types
    uint32 internal constant WOTS_HASH = 0;
    uint32 internal constant WOTS_PK = 1;
    uint32 internal constant TREE = 2;
    uint32 internal constant FORS_TREE = 3;
    uint32 internal constant FORS_ROOTS = 4;

    uint256 internal constant SIG_LEN = 7856;
    uint256 internal constant PK_LEN = 32;

    // ADRS fields, mapped to the FIPS 205 / noble byte-PACKED 22-byte compressed layout:
    //   byte 0      layer
    //   bytes 1-8   tree (uint64 BE)
    //   byte 9      type
    //   bytes 12-13 keypair address (2 bytes; tree height 9 > 8)
    //   byte 17     chain address OR tree height (single byte)
    //   bytes 18-21 tree index (uint32 BE)
    //   byte 21     hash address (single byte; WOTS only, overrides index low byte)
    struct Adrs {
        uint32 layer;
        uint64 tree;
        uint32 typ;
        uint32 keypair;
        uint32 chainHeight; // chain address or tree height
        uint32 treeIndex;
        uint32 hash;
    }

    // ---- SHA-256 precompile ----
    function sha256mem(bytes memory data) private view returns (bytes32 out) {
        (bool ok, bytes memory r) = address(0x02).staticcall(data);
        require(ok && r.length == 32, "sha256 precompile");
        out = bytes32(r);
    }

    // Compressed ADRS for SHA2 (22 bytes), byte-packed exactly as the noble reference.
    function adrsc(Adrs memory a) private pure returns (bytes memory out) {
        out = new bytes(22);
        out[0] = bytes1(uint8(a.layer));
        for (uint256 i = 0; i < 8; i++) out[1 + i] = bytes1(uint8(a.tree >> (8 * (7 - i))));
        out[9] = bytes1(uint8(a.typ));
        out[12] = bytes1(uint8(a.keypair >> 8));
        out[13] = bytes1(uint8(a.keypair));
        out[17] = bytes1(uint8(a.chainHeight));
        out[18] = bytes1(uint8(a.treeIndex >> 24));
        out[19] = bytes1(uint8(a.treeIndex >> 16));
        out[20] = bytes1(uint8(a.treeIndex >> 8));
        out[21] = bytes1(uint8(a.treeIndex));
        if (a.hash != 0) out[21] = bytes1(uint8(a.hash)); // WOTS hash address overrides
    }

    function _put4(bytes memory b, uint256 off, uint32 v) private pure {
        b[off]     = bytes1(uint8(v >> 24));
        b[off + 1] = bytes1(uint8(v >> 16));
        b[off + 2] = bytes1(uint8(v >> 8));
        b[off + 3] = bytes1(uint8(v));
    }

    // Tweakable hash Th(PK.seed, ADRS, M) = Trunc_n( SHA256(PK.seed || 0^{64-n} || ADRSc || M) ).
    // F, H and T_len are all this construction; they differ only by |M|.
    function th(bytes memory pkSeed, Adrs memory a, bytes memory m) private view returns (bytes memory) {
        bytes memory pad = new bytes(64 - N); // 48 zero bytes
        bytes memory input = bytes.concat(pkSeed, pad, adrsc(a), m);
        bytes32 d = sha256mem(input);
        bytes memory out = new bytes(N);
        for (uint256 i = 0; i < N; i++) out[i] = d[i];
        return out;
    }

    // MGF1-SHA256(seed, maskLen)
    function mgf1(bytes memory seed, uint256 maskLen) private view returns (bytes memory out) {
        out = new bytes(maskLen);
        uint256 filled = 0;
        uint32 counter = 0;
        while (filled < maskLen) {
            bytes memory c = new bytes(4);
            _put4(c, 0, counter);
            bytes32 blk = sha256mem(bytes.concat(seed, c));
            for (uint256 i = 0; i < 32 && filled < maskLen; i++) {
                out[filled++] = blk[i];
            }
            counter++;
        }
    }

    // Hmsg(R, PK.seed, PK.root, M) = MGF1-SHA256(R || PK.seed || SHA256(R || PK.seed || PK.root || M), m)
    function hMsg(bytes memory r, bytes memory pkSeed, bytes memory pkRoot, bytes memory m)
        private view returns (bytes memory)
    {
        bytes32 inner = sha256mem(bytes.concat(r, pkSeed, pkRoot, m));
        bytes memory seed = bytes.concat(r, pkSeed, abi.encodePacked(inner));
        return mgf1(seed, M_DIGEST);
    }

    // WOTS+ chain: iterate F from `start` for `steps` steps, updating the hash address each step.
    function chain(bytes memory x, uint256 start, uint256 steps, bytes memory pkSeed, Adrs memory a)
        private view returns (bytes memory)
    {
        bytes memory t = x;
        for (uint256 i = start; i < start + steps; i++) {
            a.hash = uint32(i); // hash address
            t = th(pkSeed, a, t);
        }
        return t;
    }

    // base_w: split M into base-w (nibble) digits, high nibble first.
    function baseW(bytes memory m, uint256 outLen) private pure returns (uint8[] memory out) {
        out = new uint8[](outLen);
        uint256 inIdx = 0;
        uint256 bits = 0;
        uint256 total = 0;
        for (uint256 o = 0; o < outLen; o++) {
            if (bits == 0) { total = uint8(m[inIdx]); inIdx++; bits = 8; }
            bits -= LGW;
            out[o] = uint8((total >> bits) & (W - 1));
        }
    }

    // wots_PKFromSig: recover the WOTS+ public key from a signature and message.
    function wotsPkFromSig(bytes memory sig, uint256 sigOff, bytes memory m, bytes memory pkSeed, Adrs memory a)
        private view returns (bytes memory)
    {
        uint8[] memory msgW = new uint8[](LEN);
        uint8[] memory m1 = baseW(m, LEN1);
        uint256 csum = 0;
        for (uint256 i = 0; i < LEN1; i++) { msgW[i] = m1[i]; csum += (W - 1) - m1[i]; }
        // csum <<= (8 - ((len2*lgw) % 8)) % 8  == <<4 for these params
        csum <<= (8 - ((LEN2 * LGW) % 8)) % 8;
        // I2OSP(csum, ceil(len2*lgw/8)) == 2 bytes, then base_w to len2 digits
        bytes memory csumBytes = new bytes(2);
        csumBytes[0] = bytes1(uint8(csum >> 8));
        csumBytes[1] = bytes1(uint8(csum));
        uint8[] memory cW = baseW(csumBytes, LEN2);
        for (uint256 i = 0; i < LEN2; i++) msgW[LEN1 + i] = cW[i];

        bytes memory tmp = new bytes(LEN * N);
        for (uint256 i = 0; i < LEN; i++) {
            a.chainHeight = uint32(i); // chain address
            a.hash = 0;
            bytes memory chunk = _slice(sig, sigOff + i * N, N);
            bytes memory ci = chain(chunk, msgW[i], (W - 1) - msgW[i], pkSeed, a);
            for (uint256 j = 0; j < N; j++) tmp[i * N + j] = ci[j];
        }
        // compress: WOTS_PK address keeps the keypair, clears chain/index/hash
        Adrs memory pkAdrs = a;
        pkAdrs.typ = WOTS_PK;
        pkAdrs.chainHeight = 0; pkAdrs.treeIndex = 0; pkAdrs.hash = 0;
        return th(pkSeed, pkAdrs, tmp);
    }

    // xmss_PKFromSig
    function xmssPkFromSig(
        uint256 idx, bytes memory sig, uint256 sigOff, bytes memory m, bytes memory pkSeed, Adrs memory a
    ) private view returns (bytes memory) {
        a.typ = WOTS_HASH;
        a.keypair = uint32(idx);
        a.chainHeight = 0; a.treeIndex = 0; a.hash = 0;
        bytes memory node = wotsPkFromSig(sig, sigOff, m, pkSeed, a);

        // auth path starts after the WOTS sig (LEN*N bytes)
        uint256 authOff = sigOff + LEN * N;
        a.typ = TREE;
        a.keypair = 0;
        a.hash = 0;
        a.treeIndex = uint32(idx);
        for (uint256 kk = 0; kk < HP; kk++) {
            a.chainHeight = uint32(kk + 1); // tree height
            bytes memory auth = _slice(sig, authOff + kk * N, N);
            if ((idx >> kk) & 1 == 0) {
                a.treeIndex = a.treeIndex / 2;
                node = th(pkSeed, a, bytes.concat(node, auth));
            } else {
                a.treeIndex = (a.treeIndex - 1) / 2;
                node = th(pkSeed, a, bytes.concat(auth, node));
            }
        }
        return node;
    }

    // ht_verify
    function htVerify(
        bytes memory m, bytes memory sigHT, bytes memory pkSeed, uint64 idxTree, uint32 idxLeaf, bytes memory pkRoot
    ) private view returns (bool) {
        uint256 xmssSig = (HP + LEN) * N; // 704
        Adrs memory a;
        a.layer = 0;
        a.tree = idxTree;
        bytes memory node = xmssPkFromSig(idxLeaf, sigHT, 0, m, pkSeed, a);
        for (uint256 j = 1; j < D; j++) {
            idxLeaf = uint32(idxTree % (1 << HP));
            idxTree = idxTree >> HP;
            a.layer = uint32(j);
            a.tree = idxTree;
            node = xmssPkFromSig(idxLeaf, sigHT, j * xmssSig, node, pkSeed, a);
        }
        return _eq(node, pkRoot);
    }

    // fors_pkFromSig
    function forsPkFromSig(bytes memory sigFors, bytes memory md, bytes memory pkSeed, Adrs memory a)
        private view returns (bytes memory)
    {
        uint256 perTree = (A + 1) * N; // 208
        bytes memory roots = new bytes(K * N);
        for (uint256 i = 0; i < K; i++) {
            uint256 idx = _forsIndex(md, i); // a-bit index
            uint256 base = i * perTree;
            bytes memory node = th(pkSeed, _forsLeafAdrs(a, i, idx), _slice(sigFors, base, N));

            uint256 authOff = base + N;
            uint256 treeIndex = i * (1 << A) + idx;
            for (uint256 j = 0; j < A; j++) {
                Adrs memory ha = a;
                ha.typ = FORS_TREE;
                ha.chainHeight = uint32(j + 1); // tree height
                ha.hash = 0;
                bytes memory auth = _slice(sigFors, authOff + j * N, N);
                if ((idx >> j) & 1 == 0) {
                    treeIndex = treeIndex / 2;
                    ha.treeIndex = uint32(treeIndex);
                    node = th(pkSeed, ha, bytes.concat(node, auth));
                } else {
                    treeIndex = (treeIndex - 1) / 2;
                    ha.treeIndex = uint32(treeIndex);
                    node = th(pkSeed, ha, bytes.concat(auth, node));
                }
            }
            for (uint256 j = 0; j < N; j++) roots[i * N + j] = node[j];
        }
        Adrs memory pkAdrs = a;
        pkAdrs.typ = FORS_ROOTS;
        pkAdrs.chainHeight = 0; pkAdrs.treeIndex = 0; pkAdrs.hash = 0;
        return th(pkSeed, pkAdrs, roots);
    }

    function _forsLeafAdrs(Adrs memory a, uint256 i, uint256 idx) private pure returns (Adrs memory ha) {
        ha = a;
        ha.typ = FORS_TREE;
        ha.chainHeight = 0; // tree height 0
        ha.hash = 0;
        ha.treeIndex = uint32(i * (1 << A) + idx);
    }

    // FORS index i: a-bit big-endian value from md bit offset i*a.
    function _forsIndex(bytes memory md, uint256 i) private pure returns (uint256 out) {
        uint256 bitStart = i * A;
        for (uint256 b = 0; b < A; b++) {
            uint256 bit = bitStart + b;
            uint256 byteIdx = bit / 8;
            uint256 bitInByte = 7 - (bit % 8);
            uint256 v = (uint8(md[byteIdx]) >> bitInByte) & 1;
            out = (out << 1) | v;
        }
    }

    // ---- helpers ----
    function _slice(bytes memory b, uint256 off, uint256 len) private pure returns (bytes memory out) {
        out = new bytes(len);
        for (uint256 i = 0; i < len; i++) out[i] = b[off + i];
    }
    function _eq(bytes memory x, bytes memory y) private pure returns (bool) {
        if (x.length != y.length) return false;
        for (uint256 i = 0; i < x.length; i++) if (x[i] != y[i]) return false;
        return true;
    }
    function _toUint(bytes memory b, uint256 off, uint256 len) private pure returns (uint256 v) {
        for (uint256 i = 0; i < len; i++) v = (v << 8) | uint8(b[off + i]);
    }

    /// @notice Verify an SLH-DSA-SHA2-128s signature over a 32-byte digest.
    /// @param pk 32-byte public key (PK.seed(16) || PK.root(16))
    /// @param message the signed message (mu_v3 = 32 bytes)
    /// @param sig 7856-byte signature
    function verify(bytes memory pk, bytes memory message, bytes memory sig) internal view returns (bool) {
        if (pk.length != PK_LEN || sig.length != SIG_LEN) return false;
        bytes memory pkSeed = _slice(pk, 0, N);
        bytes memory pkRoot = _slice(pk, N, N);

        bytes memory r = _slice(sig, 0, N);
        uint256 forsLen = K * (A + 1) * N; // 2912
        bytes memory sigFors = _slice(sig, N, forsLen);
        bytes memory sigHT = _slice(sig, N + forsLen, sig.length - N - forsLen);

        // FIPS 205 pure-mode domain separation: the signed message is (0x00 || ctxLen(0) || M).
        // This matches the default noble sign/verify with an empty context, so the identical
        // signature verifies on-chain and off-chain.
        bytes memory m2 = bytes.concat(hex"0000", message);
        bytes memory digest = hMsg(r, pkSeed, pkRoot, m2);
        // md = digest[0:21]; idxTree = digest[21:28] mod 2^54; idxLeaf = digest[28:30] mod 2^9
        bytes memory md = _slice(digest, 0, 21);
        uint64 idxTree = uint64(_toUint(digest, 21, 7) % (uint256(1) << (H - HP)));
        uint32 idxLeaf = uint32(_toUint(digest, 28, 2) % (uint256(1) << HP));

        Adrs memory a;
        a.tree = idxTree;
        a.typ = FORS_TREE;
        a.keypair = idxLeaf;
        bytes memory forsPk = forsPkFromSig(sigFors, md, pkSeed, a);

        return htVerify(forsPk, sigHT, pkSeed, idxTree, idxLeaf, pkRoot);
    }
}
